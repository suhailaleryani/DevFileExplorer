{
  "name": "dev-file-explorer",
  "private": true,
  "description": "A fast file explorer for developers with a large projects folder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhailaleryani/DevFileExplorer.git"
  },
  "homepage": "https://github.com/suhailaleryani/DevFileExplorer#readme",
  "bugs": {
    "url": "https://github.com/suhailaleryani/DevFileExplorer/issues"
  },
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "node --test \"tests/unit/*.test.ts\" \"tests/contract/*.test.mjs\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:smoke": "powershell -NoProfile -File tests/smoke/app-smoke.ps1",
    "test:ui": "node tests/demo/tabs-check.mjs && node tests/demo/tab-roots-check.mjs && node tests/demo/back-selection-check.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
